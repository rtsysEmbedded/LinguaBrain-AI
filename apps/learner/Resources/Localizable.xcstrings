    "فایل دیتابیس Anki داخل بسته پیدا نشد.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل دیتابیس Anki داخل بسته پیدا نشد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Anki database file was not found inside the package."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anki-Datenbankdatei wurde im Paket nicht gefunden."
          }
        }
      }
    },
    "فایل قبل از استخراج از نظر مسیرهای خطرناک، رمزگذاری، تعداد فایل، حجم بازشده و نسبت فشرده‌سازی بررسی می‌شود.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل قبل از استخراج از نظر مسیرهای خطرناک، رمزگذاری، تعداد فایل، حجم بازشده و نسبت فشرده‌سازی بررسی می‌شود."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is checked for dangerous paths, encryption, file count, unzipped volume and compression ratio before extraction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird vor dem Extrahieren auf gefährliche Pfade, Verschlüsselung, Dateianzahl, entpacktes Volumen und Komprimierungsverhältnis überprüft."
          }
        }
      }
    },
