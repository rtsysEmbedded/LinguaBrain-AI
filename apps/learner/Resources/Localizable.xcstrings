    "ابتدا API Key مربوط به OpenRouter را در تنظیمات ذخیره کن.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا API Key مربوط به OpenRouter را در تنظیمات ذخیره کن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, save the OpenRouter API Key in the settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie zunächst den OpenRouter API Key in den Einstellungen."
          }
