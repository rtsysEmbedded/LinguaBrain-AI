    "برای ساخت کارت هوشمند، ابتدا OpenRouter را در تنظیمات فعال کن.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ساخت کارت هوشمند، ابتدا OpenRouter را در تنظیمات فعال کن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To create a smart card, first enable OpenRouter in settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine Smartcard zu erstellen, aktivieren Sie zunächst OpenRouter in den Einstellungen."
          }
        }
      }
    },
