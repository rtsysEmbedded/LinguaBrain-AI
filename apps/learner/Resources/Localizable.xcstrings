    "او همکار بسیار قابل اعتمادی است.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "او همکار بسیار قابل اعتمادی است."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He is a very reliable colleague."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist ein sehr zuverlässiger Kollege."
          }
        }
      }
    },
    "این بسته از فرمت جدید collection.anki21b استفاده می‌کند که هنوز پشتیبانی نمی‌شود. خروجی سازگار collection.anki21 یا collection.anki2 را وارد کن.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این بسته از فرمت جدید collection.anki21b استفاده می‌کند که هنوز پشتیبانی نمی‌شود. خروجی سازگار collection.anki21 یا collection.anki2 را وارد کن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This package uses the new collection.anki21b format, which is not yet supported. Import compatible output collection.anki21 or collection.anki2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Paket verwendet das neue Format „collection.anki21b“, das noch nicht unterstützt wird. Importieren Sie die kompatible Ausgabe „collection.anki21“ oder „collection.anki2“."
          }
        }
      }
    },
    "این واژه به فارسی یعنی چه؟": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این واژه به فارسی یعنی چه؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does this word mean in Farsi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bedeutet dieses Wort auf Farsi?"
          }
        }
      }
    },
    "این کار ۵۰ واژه را به حالت اولیه برمی‌گرداند و قابل بازگشت نیست.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار ۵۰ واژه را به حالت اولیه برمی‌گرداند و قابل بازگشت نیست."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resets 50 words to their original state and cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden 50 Wörter auf ihren ursprünglichen Zustand zurückgesetzt und können nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "این گالری برای بررسی محتوا و تعامل است؛ رنگ و گرافیک هنوز نهایی نیست.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گالری برای بررسی محتوا و تعامل است؛ رنگ و گرافیک هنوز نهایی نیست."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This gallery is for checking content and interaction; Color and graphics are not final yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Galerie dient der Überprüfung von Inhalten und Interaktion; Farbe und Grafik sind noch nicht endgültig."
          }
        }
      }
    },
    "باشه": {
