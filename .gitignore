# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local projects intentionally outside this repository scope
/noji_anki/

# Temporary and editor files
*.swp
*.swo
*~
.idea/
.vscode/

# Environment files and local secrets
.env
.env.*
!.env.example
*.key
*.pem

# AI-agent local credentials and machine-specific settings
.agents/.credentials/
.agents/cache/
.claude/settings.local.json
.gemini/settings.json
.gemini/.env

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
.n8n/

# Third-party Anki decks are local test inputs only: they are large and their
# redistribution license is unknown. Keep them outside version control.
/assets/German_Top_4000_vocabulary.apkg

# Private/generated experiment inputs and exports
/experiments/vocabulary-mvp/*.csv
/experiments/vocabulary-mvp/*.xlsx
/experiments/vocabulary-mvp/*.xlsm

# Swift, Swift Package Manager, and Xcode generated/local files
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
DerivedData/
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Keep source projects, workspaces, entitlements, and app-level Package.resolved files tracked.
# NOTE: packages/ directory is tracked but may contain build artifacts that should be excluded individually

# Generated documentation output
site/
build/
DerivedData/
.build/
.swiftpm/
*.xcodeproj/
